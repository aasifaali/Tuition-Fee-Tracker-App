<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Login · <%= settings.center_name %></title>
  <link rel="stylesheet" href="/style.css">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
</head>
<body style="padding-bottom:0">
  <div class="login-wrap">
    <form class="card login-card" method="post" action="/login">
      <h1><%= settings.center_name %></h1>
      <p class="muted" style="margin:0 0 20px">Sign in to manage fees and attendance</p>
      <% if (error) { %><div class="flash error"><%= error %></div><% } %>
      <div class="field">
        <label for="username">Username</label>
        <input id="username" name="username" autocomplete="username" autocapitalize="none" required autofocus>
      </div>
      <div class="field">
        <label for="password">Password</label>
        <input id="password" name="password" type="password" autocomplete="current-password" required>
      </div>
      <button class="btn primary block lg">Sign in</button>
    </form>
  </div>
</body>
</html>
